@page "/all-tickets"
@attribute [Authorize(Roles = "TechSupport,SupportManager")]
@using Microsoft.AspNetCore.Identity
@using BlazorApp1.Models
@inject UserManager<ApplicationUser> UserManager
@inject BlazorApp1.Services.TicketState TicketState
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<h3>All tickets (Tech Support)</h3>

<table class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>Title</th>
            <th>User</th>
            <th>Status</th>
            <th>Created</th>
            <th>Employee</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Tickets)
        {
            <tr>
                <td>@t.TicketId</td>
                <td>@t.Title</td>
                <td>@GetUserEmail(t.UserId)</td>
                <td>
                    <select @onchange="(e) => ChangeStatus(t.TicketId, e.Value?.ToString())" 
                            class="form-select form-select-sm" 
                            style="width:140px;">
                        <option value="1" selected="@(t.StatusId == 1 ? "selected" : null)">New</option>
                        <option value="2" selected="@(t.StatusId==2)">In Progress</option>
                        <option value="3" selected="@(t.StatusId==3)">Closed</option>
                    </select>
                </td>
                <td>@t.CreatedAt.ToLocalTime().ToString("g")</td>
                <td>@GetUserEmail(t.EmployeeId)</td>
                <td><button class="btn btn-link" @onclick="() => Edit(t.TicketId)">Open</button></td>
                <td><button class="btn btn-danger" @onclick="() => Delete(t.TicketId)">Delete</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private Action? _onChangeHandler;
    private IEnumerable<BlazorApp1.Models.Ticket> Tickets = Array.Empty<BlazorApp1.Models.Ticket>();
    private Dictionary<string, string> UsersMap = new();
    private async Task Delete(int id)
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var confirmed = await JS.InvokeAsync<bool>("confirm", 
            "Delete this ticket?");

        if (!confirmed) return;

        if (!user.IsInRole("TechSupport") && 
            !user.IsInRole("SupportManager"))
            return;

        TicketState.Delete(id);
        Tickets = TicketState.GetAll();
    }

    private string GetUserEmail(string? id)
    {
        if (string.IsNullOrEmpty(id))
            return "-";

        return UsersMap.TryGetValue(id, out var email)? email : id;
    }

    protected override async Task OnInitializedAsync()
    {
        var users = UserManager.Users.ToList();
        foreach (var user in users) UsersMap[user.Id] = user.Email ?? user.UserName ?? user.Id;
        _onChangeHandler = () => InvokeAsync(() =>
        {
            Tickets = TicketState.GetAll();
            StateHasChanged();
        });
        TicketState.OnChange += _onChangeHandler;
        Tickets = TicketState.GetAll();
    }


    private void ChangeStatus(int id, string? value)
    {
        if (!int.TryParse(value, out var s)) return;
        TicketState.ChangeStatus(id, s);
    }

    private void Edit(int id) => NavigationManager.NavigateTo($"/edit-ticket/{id}");

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    public void Dispose() => TicketState.OnChange -= _onChangeHandler;
}