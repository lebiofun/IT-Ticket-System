@page "/my-tickets"
@using System.Security.Claims
@attribute [Authorize(Roles="EndUser, TechSupport, SupportManager")]
@inject BlazorApp1.Services.TicketState TicketState  
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@rendermode InteractiveServer

<h3>My tickets</h3>
<div class="mb-3">
    <button class="btn btn-success" @onclick="CreateNew">Create ticket</button>
</div>

<table class="table table-striped">
    <thead>
        <tr><th>#</th><th>Title</th><th>Status</th><th>Updated</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var t in Tickets)
        {
            <tr>
                <td>@t.TicketId</td>
                <td>@t.Title</td>
                @if (t.StatusId == 1)
                {
                    <td><span class="badge bg-warning text-dark">Open</span></td>
                }
                else if (t.StatusId == 2)
                {
                    <td><span class="badge bg-info text-dark">In Progress</span></td>
                }
                else if (t.StatusId == 3)
                {
                    <td><span class="badge bg-success">Closed</span></td>
                }
                else
                {
                    <td><span class="badge bg-secondary">Unknown</span></td>
                }
                <td>@(t.UpdatedAt?.ToLocalTime().ToString("g") ?? t.CreatedAt.ToLocalTime().ToString("g"))</td>
                <td><button class="btn btn-link" @onclick="() => Edit(t.TicketId)">Edit</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private Action? _onChangeHandler;
    private IEnumerable<BlazorApp1.Models.Ticket> Tickets = Array.Empty<BlazorApp1.Models.Ticket>();
    protected override async Task OnInitializedAsync()
    {
        _onChangeHandler = async () =>
        {
            await Load();
            StateHasChanged();
        };

        TicketState.OnChange += _onChangeHandler;

        await Load();
    }

    private async Task Load()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            Tickets = TicketState.GetByUserOrEmployee(userId);
        }
    }



    private void CreateNew() => Nav.NavigateTo("/create-ticket");
    private void Edit(int id) => Nav.NavigateTo($"/edit-ticket/{id}");
    public void Dispose() => TicketState.OnChange -= _onChangeHandler;
}
