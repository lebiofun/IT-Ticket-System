@page "/edit-ticket/{TicketId:int}"
@attribute [Authorize]
@inject AuthenticationStateProvider AuthProvider
@rendermode InteractiveServer
@inject BlazorApp1.Services.TicketState TicketState
@inject NavigationManager Nav

<h3>Edit Ticket</h3>

@if (Ticket == null)
{
    <p>Ticket not found.</p>
}
else
{
    <div class="card p-3">
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input class="form-control" @bind="Ticket.Title" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" rows="5" @bind="Ticket.Description"></textarea>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="Save">Save</button>
            <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </div>
    </div>
}

@code {
    [Parameter] public int TicketId { get; set; }

    private BlazorApp1.Models.Ticket? Ticket;

    protected override void OnInitialized()
    {
        Ticket = TicketState.GetById(TicketId);
    }

    private async Task Save()
    {
        if (Ticket == null) return;

        TicketState.Update(Ticket);

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.IsInRole("EndUser"))
            Nav.NavigateTo("/my-tickets");
        else
            Nav.NavigateTo("/all-tickets");
    }

    private void Cancel() => Nav.NavigateTo("/my-tickets");
}
