@page "/assign-tech"
@attribute [Authorize(Roles = "SupportManager")]
@inject NavigationManager Nav
@inject BlazorApp1.Services.TicketState TicketState
@rendermode InteractiveServer

<h3>Assign tech support (Manager)</h3>
<p>Клик по Assign назначит employee id для примера.</p>

<table class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>Title</th>
            <th>Assigned</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var t in TicketState.GetAll())
        {
            <tr>
                <td>@t.TicketId</td>
                <td>@t.Title</td>
                <td>@(t.EmployeeId?.ToString() ?? "-")</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Assign(t.TicketId, 42)">Assign to #42</button>
                </td>
                <td>
                    <td><button class="btn btn-link" @onclick="() => Edit(t.TicketId)">Open</button></td>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private void Edit(int id) => Nav.NavigateTo($"/edit-ticket/{id}");

    private void Assign(int ticketId, int employeeId) => TicketState.AssignEmployee(ticketId, employeeId);
}