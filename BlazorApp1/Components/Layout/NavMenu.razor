@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider

<div class="top-row ps-3 navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">IT Support</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">

        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
            Home
        </NavLink>

        <AuthorizeView Roles="EndUser">
            <NavLink class="nav-link" href="/create-ticket">Create Ticket</NavLink>
            <NavLink class="nav-link" href="/my-tickets">My Tickets</NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="TechSupport">
            <NavLink class="nav-link" href="/all-tickets">All Tickets</NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="SupportManager">
            <NavLink class="nav-link" href="/assign-tech">Assign Tech</NavLink>
            <NavLink class="nav-link" href="/reports">Reports</NavLink>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-link" href="/logout">Logout</NavLink>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-link" href="/loginpage">Login</NavLink>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>
