<UserControl x:Class="Ticket_System.core.View.EnterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ticket_System.core.View"
             xmlns:viewModel="clr-namespace:Ticket_System.core.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox Style="{StaticResource Textbox1}" Foreground="White" FontSize="14" Grid.Column="1" Width="150" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        <TextBox Style="{StaticResource Textbox1}" Foreground="White" FontSize="14" Grid.Column="1" Width="150" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <Label Grid.Column="1" Content="Login" Foreground="White" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Command="{Binding DataContext.RegistrationViewCommand,
          RelativeSource={RelativeSource AncestorType=Window}}" Content="Registration" FontSize="15" Foreground="White" Height="30" Width="150" Background="Orange" Style="{StaticResource ButtonStyle}" Grid.Column="1" HorizontalAlignment="Left" Margin="0,25,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Button Content="Login" FontSize="15" Foreground="White" Height="30" Width="150" Background="Orange" Style="{StaticResource ButtonStyle}" Grid.Column="1" HorizontalAlignment="Left" Margin="250,25,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Label Foreground="White" FontSize="15" Grid.Column="1" Content="First Name" HorizontalAlignment="Left" Margin="34,125,0,0" VerticalAlignment="Top"/>
        <Label Foreground="White" FontSize="15" Grid.Column="1" Content="Password" HorizontalAlignment="Right" Margin="0,125,39,0" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
