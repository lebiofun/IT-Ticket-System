<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GameButtonStyle" TargetType="Button">
        <Setter Property="TextElement.FontFamily" Value="Fomts/Dosis-Bold.ttf"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="#20214f"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Width="100" Height="100" CornerRadius="12" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#25236b"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Storyboard x:Key="FalseStateAnimation">
        <DoubleAnimation Storyboard.TargetName="ImageTran" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="RectangleChat" Storyboard.TargetProperty="Height" To="340" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="RectangleChat" Storyboard.TargetProperty="Margin" To="605,0,0,0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="RectangleInputChat" Storyboard.TargetProperty="Width" To="156" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="RectangleInputChat" Storyboard.TargetProperty="Margin" To="0,0,32,7" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="TextChatIn" Storyboard.TargetProperty="Width" To="108" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="TextChatIn" Storyboard.TargetProperty="Margin" To="0,0,50,7" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="BtnSend" Storyboard.TargetProperty="Margin" To="0,0,20,0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="TextboxChat" Storyboard.TargetProperty="Height" To="283" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="TextboxChat" Storyboard.TargetProperty="Margin" To="613,10,0,0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="SliderRectangle" Storyboard.TargetProperty="Height" To="275" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="SliderRectangle" Storyboard.TargetProperty="Margin" To="0,10,32,0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="CustomThumb" Storyboard.TargetProperty="Height" To="39" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="CustomThumb" Storyboard.TargetProperty="Width" To="15" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="CanvasCustomThumb" Storyboard.TargetProperty="Height" To="303" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="CanvasCustomThumb" Storyboard.TargetProperty="Margin" To="0,0,20,0" Duration="0:0:0.3"/>
    </Storyboard>

    <!--Анимация когда ToggleButton True-->
    <Storyboard x:Key="TrueStateAnimation">
        <DoubleAnimation Storyboard.TargetName="ImageTran" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="RectangleChat" Storyboard.TargetProperty="Height" To="42" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="RectangleChat" Storyboard.TargetProperty="Margin" To="605,298,0,0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="RectangleInputChat" Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="RectangleInputChat" Storyboard.TargetProperty="Margin" To="0,0,158,7" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="TextChatIn" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="TextChatIn" Storyboard.TargetProperty="Margin" To="0,0,158,7" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="BtnSend" Storyboard.TargetProperty="Margin" To="0,0,20,-70" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="TextboxChat" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="TextboxChat" Storyboard.TargetProperty="Margin" To="613,303,0,0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="SliderRectangle" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="SliderRectangle" Storyboard.TargetProperty="Margin" To="0,285,32,0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="CustomThumb" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="CustomThumb" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.3"/>
        <DoubleAnimation Storyboard.TargetName="CanvasCustomThumb" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.3"/>
        <ThicknessAnimation Storyboard.TargetName="CanvasCustomThumb" Storyboard.TargetProperty="Margin" To="0,303,20,0" Duration="0:0:0.3"/>
    </Storyboard>
</ResourceDictionary>
